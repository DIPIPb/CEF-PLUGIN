{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/icons/:id.png", "destination": "/api/icon?id=:id" }
  ],
  "headers": [
    {
      "source": "/((?!api/|icons/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
